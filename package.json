{
  "name": "compreesor-web",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "prepare:media": "node scripts/copy-ffmpeg-core.mjs",
    "predev": "npm run prepare:media",
    "dev": "vite",
    "prebuild": "npm run prepare:media",
    "build": "tsc -b && vite build",
    "lint": "oxlint src tests scripts vite.config.ts",
    "preview": "vite preview",
    "cli:test": "npm --prefix packages/cli test",
    "desktop:dev": "npm --prefix apps/desktop start",
    "desktop:dist": "npm --prefix apps/desktop run dist"
  },
  "dependencies": {
    "@ffmpeg/core": "^0.12.10",
    "@ffmpeg/ffmpeg": "^0.12.15",
    "@ffmpeg/util": "^0.12.2",
    "@jsquash/avif": "^2.1.1",
    "@jsquash/jpeg": "^1.6.0",
    "@jsquash/jxl": "^1.3.0",
    "@jsquash/oxipng": "^2.3.0",
    "@jsquash/png": "^3.1.1",
    "@jsquash/resize": "^2.1.1",
    "@jsquash/webp": "^1.5.0",
    "@phosphor-icons/react": "^2.1.10",
    "@vercel/analytics": "^2.0.1",
    "fflate": "^0.8.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "svgo": "^4.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
