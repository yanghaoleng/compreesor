{
  "name": "compreesor-desktop",
  "version": "1.1.2",
  "description": "Compreesor desktop app for drag-and-drop image compression and conversion.",
  "type": "module",
  "main": "main.js",
  "author": "Mikey Wa",
  "license": "MIT",
  "private": true,
  "scripts": {
    "web:build": "npm --prefix ../.. run build -- --base=./ --outDir apps/desktop/web-dist --emptyOutDir",
    "start": "npm run web:build && electron .",
    "test": "node test/native-files.test.mjs",
    "dist": "npm run web:build && electron-builder --mac dmg zip"
  },
  "dependencies": {
    "compreesor-cli": "file:../../packages/cli"
  },
  "devDependencies": {
    "electron": "^43.4.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "icu.mikeywa.compreesor",
    "productName": "Compreesor",
    "asar": true,
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "native-files.js",
      "preload.cjs",
      "web-protocol.js",
      "renderer/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "web-dist",
        "to": "web"
      }
    ],
    "mac": {
      "category": "public.app-category.graphics-design",
      "identity": "-",
      "hardenedRuntime": false,
      "target": [
        "dmg",
        "zip"
      ]
    },
    "dmg": {
      "title": "Compreesor ${version}"
    }
  }
}
